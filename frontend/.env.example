# URL base da API Moblytix.
# Em desenvolvimento pode ser deixado como /api/v1 — o Vite faz proxy para
# VITE_PROXY_TARGET (padrao http://localhost:3000), evitando CORS.
VITE_API_URL=/api/v1

# Alvo do proxy de desenvolvimento
VITE_PROXY_TARGET=http://localhost:3000

# Centro inicial do mapa (lat,lng) e zoom
VITE_MAP_CENTER=-23.5505,-46.6333
VITE_MAP_ZOOM=13
