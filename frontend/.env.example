# URL base da API Moblytix.
# Em desenvolvimento pode ser deixado como /api/v1 — o Vite faz proxy para
# VITE_PROXY_TARGET (padrao http://localhost:3000), evitando CORS.
VITE_API_URL=/api/v1

# Alvo do proxy de desenvolvimento
VITE_PROXY_TARGET=http://localhost:3000

# Centro inicial do mapa (lat,lng) e zoom
VITE_MAP_CENTER=-23.5505,-46.6333
VITE_MAP_ZOOM=13

# Base cartografica. O padrao e o OpenStreetMap: gratuito e sem chave de API.
# A politica de uso do OSM pede atribuicao visivel e desaconselha volume alto de
# requisicoes — em producao, prefira um provedor dedicado (todos com plano gratuito):
#   CARTO    https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png
#   MapTiler https://api.maptiler.com/maps/streets-v2/{z}/{x}/{y}.png?key=SUA_CHAVE
#   Stadia   https://tiles.stadiamaps.com/tiles/alidade_smooth/{z}/{x}/{y}{r}.png
# Ao trocar de provedor, ajuste tambem a atribuicao exigida por ele.
VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAP_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>
