# Servidor
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1

# Banco de dados PostgreSQL + PostGIS
DATABASE_URL=postgres://mobility_app:change_me@localhost:5432/urban_mobility
PGSSL=false
DB_POOL_MAX=20
DB_IDLE_TIMEOUT_MS=30000

# Autenticacao
JWT_SECRET=change_me_to_a_long_random_secret
JWT_EXPIRES_IN=8h
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12

# CORS
CORS_ORIGIN=http://localhost:5173

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300

# Ingestao de dados de sensores/veiculos (chave de servico, alternativa a JWT)
DEVICE_INGEST_API_KEY=change_me_device_key
